# ============================================================
# WealthView Duo — Environment Configuration
# Copy to .env and fill in your values.
# ============================================================

# --- Database ---
POSTGRES_USER=wealthview
POSTGRES_PASSWORD=wealthview_secret
POSTGRES_DB=wealthview_duo

# --- Redis ---
REDIS_PASSWORD=redis_secret

# --- App Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_this_to_a_strong_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Demo Mode ---
# Set to true for local dev without real bank credentials
DEMO_MODE=true

# --- Plaid (Bank Integration) ---
# Sign up at https://plaid.com/docs/
# TODO: Fill in when moving out of demo mode
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox  # sandbox | development | production

# --- Financial Modeling Prep (Investments — Top Picks ETF rankings) ---
# Real market data behind Investments -> Top Picks (top 5 this week, top
# 10 this month), refreshed daily by /api/cron/refresh-etf-data. Sign up
# at https://financialmodelingprep.com/ for a free-tier API key. Without
# this set, the cron route no-ops and Top Picks shows no ranked data.
FMP_API_KEY=

# --- OpenAI (Finance Chat) ---
# TODO: Add your OpenAI API key for the chat assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Email (account verification) ---
# Sends the "confirm your email" message via Resend (https://resend.com).
# Partner invites are shareable links now (not emailed), so this is only
# used for account email verification. Get an API key from the Resend
# dashboard. EMAIL_FROM must be on a domain verified in Resend, or leave
# unset to use their onboarding@resend.dev sandbox sender — which only
# delivers to the Resend account's own email, not real recipients.
RESEND_API_KEY=
EMAIL_FROM=WealthView Duo <noreply@triagebeacon.com>

# --- SMTP (legacy backend, unused by the current Supabase-based app) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Environment ---
ENVIRONMENT=development  # development | staging | production

# --- Feature Flags ---
ENABLE_PLAID=false
ENABLE_OPENAI_CHAT=false
ENABLE_REAL_ETF_DATA=false
